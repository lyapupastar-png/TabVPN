{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.1.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/earth.svg",
    "32": "icons/earth.svg",
    "48": "icons/earth.svg",
    "96": "icons/earth.svg",
    "128": "icons/earth.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabvpn@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "contextualIdentities",
    "cookies",
    "proxy",
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["proxy.js", "webrtc-guard.js", "contextmenu.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "TabVPN",
    "default_icon": "icons/earth.svg"
  }
}
